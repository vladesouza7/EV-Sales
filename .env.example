# Copie para .env e rode ./scripts/gerar-segredos.sh — ele preenche os três segredos.
# As chaves abaixo são PROPOSITALMENTE INVÁLIDAS. Se o app subir com elas, algo está errado.

POSTGRES_PASSWORD=troque-esta-senha
EVSALES_DATABASE_URL=postgresql+psycopg://evsales:troque-esta-senha@postgres:5432/evsales

# ADR-007: chave e pepper são variáveis SEPARADAS, para que vazar uma não entregue a outra.
# 32 bytes em base64 cada. PERDER A CHAVE É PERDER TODOS OS NOMES E TELEFONES —
# guarde uma cópia FORA DO SERVIDOR, no gerenciador de senhas do Raí.
EVSALES_PII_KEY=INVALIDA-rode-scripts/gerar-segredos.sh
EVSALES_PII_PEPPER=INVALIDA-rode-scripts/gerar-segredos.sh
EVSALES_JWT_SECRET=INVALIDA-rode-scripts/gerar-segredos.sh
