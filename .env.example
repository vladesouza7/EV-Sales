# Copie para .env e rode ./scripts/gerar-segredos.sh — ele preenche os três segredos.
# As chaves abaixo são PROPOSITALMENTE INVÁLIDAS. Se o app subir com elas, algo está errado.

POSTGRES_PASSWORD=troque-esta-senha
EVSALES_DATABASE_URL=postgresql+psycopg://evsales:troque-esta-senha@postgres:5432/evsales

# ADR-007: chave e pepper são variáveis SEPARADAS, para que vazar uma não entregue a outra.
# 32 bytes em base64 cada. PERDER A CHAVE É PERDER TODOS OS NOMES E TELEFONES —
# guarde uma cópia FORA DO SERVIDOR, no gerenciador de senhas do Raí.
EVSALES_PII_KEY=INVALIDA-rode-scripts/gerar-segredos.sh
EVSALES_PII_PEPPER=INVALIDA-rode-scripts/gerar-segredos.sh
EVSALES_JWT_SECRET=INVALIDA-rode-scripts/gerar-segredos.sh

# ─── ADR-012: o provedor é configuração ───────────────────────────────────────────
# openrouter | ollama | gemini | nvidia | compativel
# Nome fora dessa lista NÃO cai no padrão: a Aurora degrada para humano. Cair no
# OpenRouter por erro de digitação seria mandar a conversa do cliente para fora da loja
# sem ninguém ter decidido isso.
EVSALES_PROVEDOR=openrouter

# Id EXATO do modelo, com versão — nunca um alias que aponte para "o mais novo". Alias
# muda a qualidade da Aurora sem um commit; trocar de modelo é PR com o eval da S-03 §8.
EVSALES_MODELO=

# A chave do provedor escolhido. O `ollama` não usa; os demais exigem.
EVSALES_LLM_API_KEY=INVALIDA-cole-a-chave-do-provedor

# Sobrescreve a URL do preset. Obrigatória com EVSALES_PROVEDOR=compativel, e é como o
# Ollama roda com outro host (no compose, http://ollama:11434/v1/chat/completions).
EVSALES_LLM_URL=

# Dois fallbacks, de fabricantes diferentes, na ordem em que devem ser tentados. Só o
# OpenRouter entende: a lista é campo do payload dele, não retentativa nossa.
EVSALES_MODELOS_FALLBACK=

# Só o OpenRouter devolve custo faturado, e ele vem em dólar; o teto do Raí é em real.
# Nos demais provedores a trilha grava 0 com `custo_faturado = false` — "não sei quanto
# custou" não é a mesma coisa que "custou zero" (ADR-012).
EVSALES_DOLAR_CENTAVOS=550

# ─── ADR-014: o que a tela /configuracoes edita ───────────────────────────────────
# Estas quatro, mais as cinco do provedor acima, são BOOTSTRAP. Depois que alguém salvar
# pela tela, o banco vence e o que ficar aqui é valor velho: esvazie a linha. A chave de
# PII, o pepper e o JWT NÃO sobem para a tela — a chave que cifra a tabela não pode morar
# na tabela que ela cifra.
EVSALES_WHATSAPP_NUMERO=
EVSALES_EVOLUTION_URL=
EVSALES_EVOLUTION_INSTANCIA=
EVSALES_EVOLUTION_CHAVE=

# ─── ADR-013: arquivos (foto de unidade e o PDF do Espelho) ───────────────────────
# Bucket PRIVADO, com dois prefixos: `fotos/` sai pelo proxy do app, `documentos/` só
# por URL assinada. O Espelho tem nome de cliente — URL pública ali seria vazamento.
EVSALES_MINIO_ENDPOINT=localhost:9000
EVSALES_MINIO_ACCESS_KEY=evsales
EVSALES_MINIO_SECRET_KEY=evsales-local
EVSALES_MINIO_BUCKET=evsales
# TLS fica no nginx do perfil prod; dentro da rede do compose o tráfego não sai.
EVSALES_MINIO_SEGURO=false
